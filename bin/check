#!/bin/sh
# The gate for main: every test, including the restart drill.
# The interpreter is the first of $EKI_PYTHON, this folder's .venv, python3
# that has pytest (the engine's own EKI_PYTHON may be a bare runtime), and
# the tests see it as EKI_PYTHON.
# In parallel when that interpreter has pytest-xdist, unless EKI_CHECK_SERIAL
# is set; a bare build without xdist runs serially. Workers: EKI_CHECK_WORKERS
# when set, always; else cores - 2 (at least 2) with EKI_CHECK_WIDE=1 (gate 2
# and the train's check, the serial steps on the way to landing); else a third
# of the cores (at least 2).
# EKI_CHECK_FAST=1 skips the tests marked `drill` (real engines, launchers).
set -e
here="$(cd "$(dirname "$0")/.." && pwd)"
cd "$here"
for py in "$EKI_PYTHON" "$here/.venv/bin/python" python3; do
    [ -n "$py" ] && "$py" -c "import pytest" >/dev/null 2>&1 || continue
    if [ "${EKI_CHECK_FAST:-}" = 1 ]; then
        set -- -m "not drill" "$@"
    fi
    if [ -z "${EKI_CHECK_SERIAL:-}" ] && "$py" -c "import xdist" >/dev/null 2>&1; then
        # a third of the cores each: several checks run at once (gate 1, agents' own
        # runs) and -n auto each drove load past 100. EKI_CHECK_WIDE=1 (gate 2, the
        # train) takes cores - 2; EKI_CHECK_WORKERS overrides both
        cores="$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 6)"
        if [ "${EKI_CHECK_WIDE:-}" = 1 ]; then
            share=$(( cores - 2 > 2 ? cores - 2 : 2 ))
        else
            share=$(( cores / 3 > 2 ? cores / 3 : 2 ))
        fi
        workers="${EKI_CHECK_WORKERS:-$share}"
        set -- -n "$workers" "$@"
    fi
    EKI_PYTHON="$py" exec "$py" -m pytest -q "$@"
done
echo "bin/check: no interpreter with pytest (tried \$EKI_PYTHON, .venv/bin/python, python3)" >&2
exit 1
