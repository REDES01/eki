#!/bin/sh
# eki: run from the checkout, no install step. Needs Python 3.11+.
here="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$0")")/.." && pwd)"
for py in "$EKI_PYTHON" "$HOME/.local/bin/python3.12" python3.12 python3.13 python3.11 python3; do
  [ -n "$py" ] && command -v "$py" >/dev/null 2>&1 && break
done
PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m eki "$@"
