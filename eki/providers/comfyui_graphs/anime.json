{
  "1": {"class_type": "CheckpointLoaderSimple",
        "inputs": {"ckpt_name": "NoobAI-XL-v1.1.safetensors"}},
  "2": {"class_type": "CLIPTextEncode",
        "inputs": {"text": "masterpiece, best quality, newest, absurdres, {{prompt}}", "clip": ["1", 1]}},
  "3": {"class_type": "CLIPTextEncode",
        "inputs": {"text": "worst quality, low quality, lowres, bad anatomy, bad hands, extra digits, fewer digits, jpeg artifacts, blurry, signature, watermark, username, text, censored, old, early",
                   "clip": ["1", 1]}},
  "4": {"class_type": "EmptyLatentImage",
        "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
  "5": {"class_type": "KSampler",
        "inputs": {"model": ["1", 0], "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0],
                   "seed": "{{seed}}", "steps": 28, "cfg": 5.0,
                   "sampler_name": "euler_ancestral", "scheduler": "normal", "denoise": 1.0}},
  "6": {"class_type": "VAEDecode",
        "inputs": {"samples": ["5", 0], "vae": ["1", 2]}},
  "7": {"class_type": "SaveImage",
        "inputs": {"filename_prefix": "eki-anime", "images": ["6", 0]}}
}
